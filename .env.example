# Local administration protection
# Keep these values out of Git and never reuse a real production password here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Set true to require Basic Auth even on localhost.
# Public/non-loopback Host headers require authentication automatically.
ADMIN_AUTH_REQUIRED=false

# Required by the anonymous intake service.
REPORTER_ID_SECRET=replace-with-a-long-random-secret

# TASK-012: Meta / WhatsApp boundary
# Do not fill with real secrets in Git.
META_APP_SECRET=replace-with-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=replace-with-webhook-verify-token
# Set the current Graph API version selected for the Meta app.
META_GRAPH_API_VERSION=replace-with-current-meta-graph-version
META_WEBHOOK_MAX_BODY_BYTES=32768

# TASK-012: Supabase server-side configuration
# Never expose SUPABASE_SERVICE_ROLE_KEY to browser/client code.
SUPABASE_URL=https://replace-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_REPORT_BUCKET=report-evidence

# Next.js admin surface (Task 013)
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
ADMIN_AUTH_REQUIRED=false
